<odoo>
  <record id="habsync_res_config_settings_view" model="ir.ui.view">
    <field name="name">res.config.settings.habsync.approval</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
    <field name="arch" type="xml">
      <xpath expr="//block[@name='quotation_order_setting_container']" position="inside">
        <setting string="Sales Approval"
                 help="Orders at or above the threshold need approval from one of the allowed approvers.">
          <div class="content-group">
            <div class="row mt8">
              <label for="habsync_approval_threshold" class="col-lg-4 o_light_label"/>
              <field name="habsync_approval_threshold"/>
            </div>
          </div>
        </setting>
      </xpath>
    </field>
  </record>
</odoo>